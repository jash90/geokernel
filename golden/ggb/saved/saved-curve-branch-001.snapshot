{
  "schema": 2,
  "id": "saved-curve-branch-001",
  "script": [
    "a = 0",
    "c = Curve(t^2, t * (t^2 - 1) + a * t, t, -2, 2)",
    "P = Point(c)",
    "Q = Point(c)",
    "p = PathParameter(P)",
    "q = PathParameter(Q)"
  ],
  "objects": {
    "a": { "type": "number", "defined": true, "value": 0.0 },
    "c": { "type": "curve", "defined": true, "start": -2.0, "end": 2.0 },
    "P": { "type": "point", "defined": true, "x": 1.0, "y": 0.0 },
    "Q": { "type": "point", "defined": true, "x": 1.0, "y": -0.0 },
    "p": { "type": "number", "defined": true, "value": 0.75 },
    "q": { "type": "number", "defined": true, "value": 0.25 }
  }
}
