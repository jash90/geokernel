  "id": "saved-expressions-001",
  "script": [
    "A = (1, 2)",
    "B = (4, -1)",
    "v_{0x} = 2",
    "C = (x(A), y(B) + 2)",
    "s = Segment(A, C)",
    "φ = x(C) + π",
    "a = sin(30° + v_{0x}°)",
    "f(x) = If[-4 < x, v_{0x} ⋅ x² + y(C), x - 1]",
    "t(x) = If[f(x) > 0 ∧ x > 0, f(x)]",
    "g(x) = If[x ≤ -2 ∨ x ≥ 2, t(x) + 1, If[x ≠ 0, f(x), a]]",
    "n = If[x(A) ≥ 0, g(x(A)), φ]",
    "Q = (n, f(y(A)))",
    "valid = x(A) ≥ 0",
    "j_{xy}(x) = f(x) + 1",
    "d = j_{xy}(y(A))",
    "ang = (v_{0x} + 30)°",
    "bad = x(A) + NextPrime(v_{0x})",
    "lost = bad + 1",
    "multi(x, y) = x + y",
    "control = Checkbox()",
    "button = Button()",
    "field = InputBox(v_{0x})"
  ],
